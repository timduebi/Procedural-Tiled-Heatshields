<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <KSPDir Condition="'$(KSPDir)' == ''">F:\Benutzer\Dokumente\science test</KSPDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Only pure-managed Unity math (Vector3, Mathf) is used, so CoreModule runs outside the game. -->
    <Reference Include="UnityEngine.CoreModule" HintPath="$(KSPDir)\KSP_x64_Data\Managed\UnityEngine.CoreModule.dll" />
    <Compile Include="..\..\src\AblatorDecals\ShieldMath.cs" />
    <Compile Include="..\..\src\AblatorDecals\SurfaceIndex.cs" />
    <Compile Include="..\..\src\AblatorDecals\TilePattern.cs" />
    <Compile Include="..\..\src\AblatorDecals\TileBuilder.cs" />
    <Compile Include="..\..\src\AblatorDecals\CoverMesh.cs" />
    <Compile Include="..\..\src\AblatorDecals\TileGlow.cs" />
    <Compile Include="..\..\src\AblatorDecals\CharStreaks.cs" />
  </ItemGroup>

</Project>
